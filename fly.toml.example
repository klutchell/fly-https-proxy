app = 'your-app-name'
primary_region = 'yyz'

[build]

[[services]]
  protocol = 'tcp'
  internal_port = 8888
  auto_stop_machines = 'suspend'
  auto_start_machines = true
  min_machines_running = 0

  [[services.ports]]
    port = 443
    handlers = ['tls']

  [[services.tcp_checks]]
    interval = '30s'
    timeout = '5s'
    grace_period = '15s'

[[vm]]
  size = 'shared-cpu-1x'
  memory = '256mb'
